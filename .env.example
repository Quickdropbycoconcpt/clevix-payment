PORT=3000

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

JWT_ACCESS_TOKEN_SECRET=replace-with-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

DATABASE_ENABLED=true
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=clevix_payments
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SYNCHRONIZE=false
DATABASE_MIGRATIONS_RUN=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=10
DATABASE_RETRY_ATTEMPTS=5
DATABASE_RETRY_DELAY=3000

MONNIFY_DEV_BASE_URL=https://sandbox.monnify.com
MONNIFY_DEV_API_KEY=
MONNIFY_DEV_SECRET_KEY=
MONNIFY_DEV_CONTRACT_CODE=
MONNIFY_DEV_WALLET_ACCOUNT_NUMBER=
