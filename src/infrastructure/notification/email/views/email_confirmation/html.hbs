<p style="margin:0 0 16px;">{{#if name}}Hi {{name}},{{else}}Hi,{{/if}}</p>

<p style="margin:0 0 16px;">
  Please confirm your email address for <strong>{{productName}}</strong>.
</p>

{{#if token}}
  <p style="margin:0 0 20px;">
    Your confirmation code is:
    <div style="font-size:20px;font-weight:700;margin:8px 0;">{{token}}</div>
  </p>
{{/if}}

{{#if link}}
  <p style="margin:0 0 24px;">
    <a href="{{link}}" style="display:inline-block;padding:12px 18px;background:#111827;color:#ffffff;text-decoration:none;border-radius:6px;">
      Confirm email
    </a>
  </p>
{{/if}}

<p style="margin:0;">Best,<br />The {{productName}} Team</p>
