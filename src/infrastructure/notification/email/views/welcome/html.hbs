<p style="margin:0 0 16px;">{{#if name}}Hi {{name}},{{else}}Hi,{{/if}}</p>

<p style="margin:0 0 16px;">
  Welcome to <strong>{{productName}}</strong>. We are glad to have you here.
</p>

{{#if loginUrl}}
  <p style="margin:0 0 20px;">You can get started from your dashboard.</p>
  <p style="margin:0 0 24px;">
    <a href="{{loginUrl}}" style="display:inline-block;padding:12px 18px;background:#111827;color:#ffffff;text-decoration:none;border-radius:6px;">
      Open dashboard
    </a>
  </p>
{{else}}
  <p style="margin:0 0 20px;">You can now get started from your dashboard.</p>
{{/if}}

<p style="margin:0;">
  Best,<br />
  The {{productName}} Team
</p>
